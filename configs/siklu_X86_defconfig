BR2_x86_64=y
BR2_WGET="wget --passive-ftp -nd -t 3 --no-hsts"
BR2_SVN="svn"
BR2_PER_PACKAGE_DIRECTORIES=y
BR2_DL_DIR="${CACHE_ROOT_DIR}/cache/80XX/buildroot-dl"
BR2_PRIMARY_SITE="${BUILDROOT_80XX_MIRROR}"
# BR2_PRIMARY_SITE_ONLY intentionally unset, same as siklu_80X0_defconfig:
# the NAS mirror is missing at least protobuf-cpp-3.18.0, so package
# fetches fall back to upstream _SITE where the mirror 404s.
BR2_CCACHE=y
BR2_CCACHE_DIR="${CACHE_ROOT_DIR}/cache/80XX/buildroot-ccache/buildroot-2026.08-x86-sdk"
BR2_SSP_NONE=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_GCC_VERSION_14_X=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_PACKAGE_LUAJIT=y
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_LIBOPENSSL=y
BR2_PACKAGE_LIBOPENSSL_BIN=y
BR2_PACKAGE_LIBUSB=y
BR2_PACKAGE_LIBUSB_COMPAT=y
BR2_PACKAGE_LIBOPING=y
BR2_PACKAGE_LIBB64=y
BR2_PACKAGE_LINUX_PAM=y
BR2_PACKAGE_LIBXCRYPT=y
BR2_PACKAGE_FMT=y
BR2_PACKAGE_NETSNMP=y
# BR2_PACKAGE_NETSNMP_ENABLE_MIBS is not set
BR2_PACKAGE_LIBPCAP=y
BR2_PACKAGE_TINYXML2=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
BR2_PACKAGE_LIBCURL_PROXY_SUPPORT=y
BR2_PACKAGE_LIBCURL_COOKIES_SUPPORT=y
BR2_PACKAGE_LIBCURL_EXTRA_PROTOCOLS_FEATURES=y
BR2_PACKAGE_LIBCURL_OPENSSL=y
BR2_PACKAGE_SPDLOG=y
BR2_PACKAGE_PROTOBUF=y
