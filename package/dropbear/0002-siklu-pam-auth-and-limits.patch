+		for (pam_env = pam_envlist; *pam_env != NULL; ++pam_env) {
+			int rc;
+
+			char* p = strstr(*pam_env, "=");
+			if (p != NULL) {
+				*p = 0;
+				rc = setenv(*pam_env, ++p, 1);
